{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/api.ts",
    "src/locales.ts",
    "src/types.ts",
    "src/hooks/**/*.ts",
    "src/voice/**/*.ts",
    "src/sidepanel/App.tsx",
    "src/sidepanel/components/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "dist-web", "src/background", "src/messaging.ts"]
}
