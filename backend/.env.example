# BharatVoice backend configuration.
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# Google Gemini API key. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Comma-separated exact CORS origins allowed to call the backend.
# For the unpacked Chrome extension, use its chrome-extension://<id> origin.
# Do not use "*". Leave empty only if you do not call the backend from a browser.
CORS_ORIGINS=chrome-extension://replace_with_your_extension_id

# Gemini model. The default is a current free-tier model; you can override it
# if your API key has access to another supported model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Upstream Gemini request timeout in seconds (0 < value <= 120).
GEMINI_TIMEOUT_SECONDS=30

# Maximum response tokens (32-4096). Keeps replies concise for read-aloud.
GEMINI_MAX_OUTPUT_TOKENS=512

# Maximum accepted request body size in bytes (256-1000000).
MAX_REQUEST_BODY_BYTES=4096

# In-memory per-client-IP rate limit (requests per minute).
# Process-local only; use a shared gateway/limiter for multi-instance deployments.
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Backend log level. Request/response content is never logged.
LOG_LEVEL=INFO
