# BharatVoice Stage 2 backend configuration
# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Google Gemini API key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins for the Chrome extension.
# Development (load unpacked): chrome-extension://<your-extension-id>
# Example (replace <EXTENSION_ID> with the actual ID shown in chrome://extensions):
# CORS_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyz,http://localhost:5173
CORS_ORIGINS=chrome-extension://your-extension-id-here

# Gemini model name
GEMINI_MODEL=gemini-1.5-flash

# Request timeouts (seconds)
GEMINI_TIMEOUT_SECONDS=30

# Maximum request body size in bytes (~4 KB)
MAX_REQUEST_BODY_BYTES=4096

# Simple in-memory rate limit: max requests per minute per client IP
RATE_LIMIT_REQUESTS_PER_MINUTE=30