{
  "name": "bharatvoice",
  "private": true,
  "version": "1.0.0",
  "description": "Multilingual, voice-first accessibility assistant for Indian government websites, powered by a FastAPI backend and Google Gemini.",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "npm run build:extension",
    "build:extension": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "build:all": "npm run build:extension && npm run build:web",
    "preview": "vite preview",
    "test": "npm run test:frontend",
    "test:frontend": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:extension && npm run typecheck:web && npm run typecheck:tests",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.293",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
