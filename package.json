{
  "name": "bharatvoice",
  "private": true,
  "version": "1.0.0",
  "description": "Multilingual, voice-first accessibility assistant for Indian government websites, powered by a FastAPI backend and Google Gemini.",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "npm run build:extension",
    "build:extension": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "build:all": "npm run build:extension && npm run build:web",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:extension && npm run typecheck:web",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.293",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
