# Backend origin used by the Chrome extension.
#
# This is a BUILD-TIME setting. After changing it you must run `npm run build`
# and reload the unpacked extension in chrome://extensions.
#
# The value must be a bare origin (no path, query, credentials, or wildcard).
# Plain HTTP is accepted only for localhost; deployed backends must use HTTPS.
#
# Development default:
BHARATVOICE_BACKEND_URL=http://localhost:8000

# Deployed example:
# BHARATVOICE_BACKEND_URL=https://bharatvoice-api.example.com
